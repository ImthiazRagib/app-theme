{% comment %}
  Renders a hero banner - the main above-the-fold section with headline, subheadline and CTA.
{% endcomment %}

<div
  class="hero-banner full-width"
  style="--hero-height: {{ section.settings.height }}px; --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-bg-color: var(--color-primary); --hero-bg-accent: var(--color-secondary); --hero-img-position: {{ section.settings.image_position | default: 'center center' }}"
>
  <div class="hero-banner__media">
    {%- if section.settings.image_url != blank -%}
      <div class="hero-banner__image hero-banner__image--url" style="background-image: url('{{ section.settings.image_url | escape }}');"></div>
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero-banner__image', alt: section.settings.title
      }}
    {%- else -%}
      <div class="hero-banner__gradient-bg"></div>
      <div class="hero-banner__pattern" aria-hidden="true"></div>
    {%- endif -%}
    <div class="hero-banner__overlay"></div>
  </div>

  <div class="hero-banner__content" style="--hero-align: {{ section.settings.text_alignment }}">
    {%- if section.settings.title != blank -%}
      <h1 class="hero-banner__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="hero-banner__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero-banner__button">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--hero-height);
  }
  .hero-banner__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-img-position);
  }
  .hero-banner__image--url {
    background-size: cover;
    background-position: var(--hero-img-position);
  }
  .hero-banner__gradient-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--hero-bg-color) 0%, var(--hero-bg-accent) 50%, var(--color-secondary-dark) 100%);
  }
  .hero-banner__pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(circle at 25% 25%, rgba(255,255,255,0.2) 0%, transparent 50%),
                      radial-gradient(circle at 75% 75%, rgba(255,255,255,0.1) 0%, transparent 50%);
  }
  .hero-banner__pattern::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 40px,
      rgba(255,255,255,0.03) 40px,
      rgba(255,255,255,0.03) 80px
    );
  }
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.4) 0%, color-mix(in srgb, var(--color-secondary) 55%, transparent) 100%);
    opacity: var(--hero-overlay);
  }
  .hero-banner__content {
    position: relative;
    z-index: 1;
    text-align: var(--hero-align);
    padding: 4rem var(--page-margin);
    max-width: 48rem;
  }
  .hero-banner__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 1rem;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.4);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .hero-banner__subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 2rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
    line-height: 1.5;
  }
  .hero-banner__button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: #fff;
    color: var(--color-secondary);
    text-decoration: none;
    font-weight: 700;
    border-radius: 8px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
  }
  .hero-banner__button:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 32px rgba(0, 0, 0, 0.35);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:landing.hero_banner",
  "settings": [
    {
      "type": "text",
      "id": "image_url",
      "label": "t:landing.background_image_url",
      "info": "t:landing.background_image_url_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:landing.background_upload"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:landing.image_position",
      "options": [
        { "value": "center center", "label": "t:landing.position.center" },
        { "value": "top center", "label": "t:landing.position.top" },
        { "value": "bottom center", "label": "t:landing.position.bottom" },
        { "value": "center left", "label": "t:landing.position.left" },
        { "value": "center right", "label": "t:landing.position.right" }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:landing.subtitle",
      "default": "Discover quality products at great prices"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:landing.button_label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:landing.hero_height",
      "min": 400,
      "max": 700,
      "step": 50,
      "unit": "px",
      "default": 550
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:landing.overlay_opacity",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 50
    }
  ],
  "presets": [{ "name": "t:landing.hero_banner" }]
}
{% endschema %}
