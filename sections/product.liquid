{% comment %}
  Product page section with image slider, details, and related products.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-page full-width">
  <div class="product-page__main">
    <div class="product-page__gallery" data-product-gallery>
      {%- if product.media.size > 0 -%}
        <div class="product-page__slider">
          {%- for media in product.media -%}
            <div class="product-page__slide {% if forloop.first %}product-page__slide--active{% endif %}" data-slide-index="{{ forloop.index0 }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1200
                    | image_tag: loading: 'lazy', alt: media.alt | default: product.title
                  }}
                {%- when 'video', 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product-page__thumbnails">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product-page__thumb {% if forloop.first %}product-page__thumb--active{% endif %}"
                data-thumb-index="{{ forloop.index0 }}"
                aria-label="{{ 'products.view_image' | t: index: forloop.index }}"
              >
                {%- if media.media_type == 'image' -%}
                  {{ media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy' }}
                {%- else -%}
                  {{ media.preview_image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy' }}
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- elsif product.featured_image -%}
        <div class="product-page__slide product-page__slide--active">
          {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title }}
        </div>
      {%- else -%}
        <div class="product-page__slide product-page__slide--active">
          {{ 'product-1' | placeholder_svg_tag: 'product-page__placeholder' }}
        </div>
      {%- endif -%}
    </div>

    <div class="product-page__info">
      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="product-page__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="product-page__price--sale">{{ product.price | money }}</span>
          <span class="product-page__price--compare">{{ product.compare_at_price | money }}</span>
          <span class="product-page__badge">{{ 'products.on_sale' | t }}</span>
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="product-page__description">
          {{ product.description }}
        </div>
      {%- endif -%}

      {% form 'product', product, class: 'product-page__form' %}
        {% assign current_variant = product.selected_or_first_available_variant %}

        {%- if product.variants.size > 1 -%}
          <div class="product-page__variant-picker">
            <label for="product-variant-{{ section.id }}">{{ 'products.variant' | t }}</label>
            <select id="product-variant-{{ section.id }}" name="id">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == current_variant %}selected="selected"{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} ({{ 'products.sold_out' | t }}){% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endif -%}

        <div class="product-page__quantity">
          <label for="quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
          <input
            type="number"
            id="quantity-{{ section.id }}"
            name="quantity"
            min="1"
            value="1"
          >
        </div>

        <button
          type="submit"
          name="add"
          class="product-page__add-to-cart"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </button>
        {{ form | payment_button }}
      {% endform %}
    </div>
  </div>

  {%- if section.settings.show_related_products and product.collections.size > 0 -%}
    {%- assign related_collection = product.collections.first -%}
    {%- assign related_limit = section.settings.related_products_count -%}
    {%- assign has_related = false -%}
    {%- for p in related_collection.products -%}
      {%- if p.id != product.id -%}
        {%- assign has_related = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_related -%}
      <div class="product-page__related">
        <h2 class="product-page__related-title">{{ 'products.related_products' | t }}</h2>
        <div class="product-page__related-grid" style="--related-gap: {{ section.settings.related_gap }}px">
          {%- assign count = 0 -%}
          {%- for related_product in related_collection.products -%}
            {%- if related_product.id != product.id -%}
              {%- if count >= related_limit -%}
                {%- break -%}
              {%- endif -%}
            <a href="{{ related_product.url }}" class="product-page__related-card">
              {%- if related_product.featured_image -%}
                {{ related_product.featured_image | image_url: width: 400, height: 400, crop: 'center' | image_tag: loading: 'lazy', alt: related_product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-page__related-placeholder' }}
              {%- endif -%}
              <h3 class="product-page__related-card-title">{{ related_product.title }}</h3>
              <p class="product-page__related-card-price">{{ related_product.price | money }}</p>
            </a>
              {%- assign count = count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% javascript %}
  (function () {
    const gallery = document.querySelector('[data-product-gallery]');
    if (!gallery) return;
    const slides = gallery.querySelectorAll('.product-page__slide');
    const thumbs = gallery.querySelectorAll('[data-thumb-index]');
    if (slides.length <= 1) return;

    function showSlide(index) {
      slides.forEach((s, i) => {
        s.classList.toggle('product-page__slide--active', i === index);
      });
      thumbs.forEach((t, i) => {
        t.classList.toggle('product-page__thumb--active', i === index);
      });
    }

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => showSlide(i));
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .product-page {
    padding: 2rem var(--page-margin) 4rem;
  }
  .product-page__main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: var(--page-width);
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .product-page__main {
      grid-template-columns: 1fr;
    }
  }
  .product-page__gallery {
    position: sticky;
    top: 2rem;
  }
  .product-page__slider {
    position: relative;
  }
  .product-page__slide {
    display: none;
  }
  .product-page__slide--active {
    display: block;
  }
  .product-page__slide img {
    width: 100%;
    height: auto;
  }
  .product-page__placeholder {
    width: 100%;
    aspect-ratio: 1;
    background: #f0f0f0;
  }
  .product-page__thumbnails {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .product-page__thumb {
    width: 60px;
    height: 60px;
    padding: 0;
    border: 2px solid transparent;
    cursor: pointer;
    background: none;
  }
  .product-page__thumb--active {
    border-color: currentColor;
  }
  .product-page__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-page__title {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }
  .product-page__price {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .product-page__price--compare {
    text-decoration: line-through;
    opacity: 0.7;
    margin-left: 0.5rem;
  }
  .product-page__badge {
    display: inline-block;
    background: #c00;
    color: #fff;
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    margin-left: 0.5rem;
  }
  .product-page__description {
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .product-page__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .product-page__variant-picker,
  .product-page__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .product-page__add-to-cart {
    padding: 1rem 2rem;
    background: var(--color-foreground);
    color: var(--color-background);
    border: none;
    font-weight: 600;
    cursor: pointer;
  }
  .product-page__add-to-cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .product-page__related {
    max-width: var(--page-width);
    margin: 3rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid #eee;
  }
  .product-page__related-title {
    margin-bottom: 2rem;
    font-size: 1.5rem;
  }
  .product-page__related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--related-gap);
  }
  @media (max-width: 768px) {
    .product-page__related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .product-page__related-card {
    text-decoration: none;
    color: inherit;
  }
  .product-page__related-card:hover .product-page__related-card-title {
    text-decoration: underline;
  }
  .product-page__related-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .product-page__related-placeholder {
    aspect-ratio: 1;
    background: #f0f0f0;
  }
  .product-page__related-card-title {
    font-size: 1rem;
    margin-top: 0.5rem;
  }
  .product-page__related-card-price {
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "t:products.show_related",
      "default": false
    },
    {
      "type": "range",
      "id": "related_products_count",
      "label": "t:products.related_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "related_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
