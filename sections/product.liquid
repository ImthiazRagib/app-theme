{% comment %}
  Product page section with image slider, details, and related products.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-page full-width">
  <div class="product-page__main">
    <div class="product-page__gallery" data-product-gallery>
      {%- if product.media.size > 0 -%}
        <div class="product-page__slider-wrap">
          <div class="product-page__slider-track" data-gallery-track style="width: {{ product.media.size | times: 100 }}%; --slide-count: {{ product.media.size }}">
            {%- for media in product.media -%}
              <div class="product-page__slide" data-slide-index="{{ forloop.index0 }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {{
                      media
                      | image_url: width: 1200
                      | image_tag: loading: 'lazy', alt: media.alt | default: product.title, class: 'product-page__media-img'
                    }}
                  {%- when 'video', 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                  {%- else -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product-page__thumbnails" data-gallery-thumbs>
            {%- for media in product.media -%}
              <button
                type="button"
                class="product-page__thumb {% if forloop.first %}product-page__thumb--active{% endif %}"
                data-thumb-index="{{ forloop.index0 }}"
                aria-label="{{ 'products.view_image' | t: index: forloop.index }}"
              >
                {%- if media.media_type == 'image' -%}
                  {{ media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy' }}
                {%- else -%}
                  {{ media.preview_image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy' }}
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- elsif product.featured_image -%}
        <div class="product-page__slider-wrap">
          <div class="product-page__slider-track" style="--slide-count: 1">
            <div class="product-page__slide">
              {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title, class: 'product-page__media-img' }}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="product-page__slider-wrap">
          <div class="product-page__slider-track" style="--slide-count: 1">
            <div class="product-page__slide">
              {{ 'product-1' | placeholder_svg_tag: 'product-page__placeholder' }}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="product-page__info">
      {%- if product.vendor != blank -%}
        <p class="product-page__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="product-page__price" data-product-price>
        {%- assign current_variant = product.selected_or_first_available_variant -%}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="product-page__price-current">{{ current_variant.price | money }}</span>
          <span class="product-page__price-compare">{{ current_variant.compare_at_price | money }}</span>
          <span class="product-page__badge">{{ 'products.on_sale' | t }}</span>
        {%- else -%}
          <span class="product-page__price-current">{{ current_variant.price | money }}</span>
          {%- if current_variant.unit_price_measurement -%}
            <span class="product-page__unit-price">{{ current_variant.unit_price | money }} / {{ current_variant.unit_price_measurement.reference_value }}{{ current_variant.unit_price_measurement.reference_unit }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="product-page__description">
          {{ product.description }}
        </div>
      {%- endif -%}

      {% form 'product', product, class: 'product-page__form', data-product-form: '', data-currency: cart.currency.iso_code %}
        {% assign current_variant = product.selected_or_first_available_variant %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

        {%- if product.has_only_default_variant == false -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_index = forloop.index0 -%}
            <div class="product-page__option">
              <label class="product-page__option-label">{{ option.name }}</label>
              <div class="product-page__options" data-option-name="{{ option.name | escape }}" data-option-index="{{ option_index }}">
                {%- assign option_lower = option.name | downcase -%}
                {%- assign is_color = false -%}
                {%- if option_lower contains 'color' or option_lower contains 'colour' -%}
                  {%- assign is_color = true -%}
                {%- endif -%}
                {%- for value in option.values -%}
                  {%- assign value_available = false -%}
                  {%- for variant in product.variants -%}
                    {%- if option_index == 0 and variant.option1 == value and variant.available -%}
                      {%- assign value_available = true -%}
                      {%- break -%}
                    {%- elsif option_index == 1 and variant.option2 == value and variant.available -%}
                      {%- assign value_available = true -%}
                      {%- break -%}
                    {%- elsif option_index == 2 and variant.option3 == value and variant.available -%}
                      {%- assign value_available = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign selected = false -%}
                  {%- if current_variant.options[option_index] == value -%}
                    {%- assign selected = true -%}
                  {%- endif -%}
                  <button
                    type="button"
                    class="product-page__option-btn {% if is_color %}product-page__option-btn--swatch{% endif %} {% if selected %}product-page__option-btn--selected{% endif %} {% unless value_available %}product-page__option-btn--unavailable{% endunless %}"
                    data-option-value="{{ value | escape }}"
                    {% unless value_available %}disabled{% endunless %}
                    title="{{ value }}{% unless value_available %} ({{ 'products.sold_out' | t }}){% endunless %}"
                  >
                    {%- if is_color and value.swatch != blank -%}
                      {%- if value.swatch.color != blank -%}
                        <span class="product-page__swatch" style="background-color: {{ value.swatch.color | color_to_hex }};"></span>
                      {%- elsif value.swatch.image != blank -%}
                        <span class="product-page__swatch product-page__swatch--img" style="background-image: url('{{ value.swatch.image | image_url: width: 40 }}');"></span>
                      {%- else -%}
                        {{ value }}
                      {%- endif -%}
                    {%- else -%}
                      {{ value }}
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}

        <div class="product-page__quantity">
          <label for="quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
          <input
            type="number"
            id="quantity-{{ section.id }}"
            name="quantity"
            min="1"
            value="1"
            class="product-page__quantity-input"
          >
        </div>

        <div class="product-page__actions">
          <button
            type="submit"
            name="add"
            class="product-page__add-to-cart"
            data-add-to-cart
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'products.add_to_cart' | t }} — {{ current_variant.price | money }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </button>
          {{ form | payment_button }}
        </div>

        {%- if current_variant.sku != blank -%}
          <p class="product-page__sku">{{ 'products.sku' | t }}: {{ current_variant.sku }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>

  {%- if section.settings.show_related_products and product.collections.size > 0 -%}
    {%- assign related_collection = product.collections.first -%}
    {%- assign related_limit = section.settings.related_products_count -%}
    {%- assign has_related = false -%}
    {%- for p in related_collection.products -%}
      {%- if p.id != product.id -%}
        {%- assign has_related = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_related -%}
      <div class="product-page__related">
        <h2 class="product-page__related-title">{{ 'products.related_products' | t }}</h2>
        <div class="product-page__related-grid" style="--related-gap: {{ section.settings.related_gap }}px">
          {%- assign count = 0 -%}
          {%- for related_product in related_collection.products -%}
            {%- if related_product.id != product.id -%}
              {%- if count >= related_limit -%}
                {%- break -%}
              {%- endif -%}
            <a href="{{ related_product.url }}" class="product-page__related-card">
              {%- if related_product.featured_image -%}
                {{ related_product.featured_image | image_url: width: 400, height: 400, crop: 'center' | image_tag: loading: 'lazy', alt: related_product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-page__related-placeholder' }}
              {%- endif -%}
              <h3 class="product-page__related-card-title">{{ related_product.title }}</h3>
              <p class="product-page__related-card-price">{{ related_product.price | money }}</p>
            </a>
              {%- assign count = count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% javascript %}
  (function () {
    const gallery = document.querySelector('[data-product-gallery]');
    if (gallery) {
      const track = gallery.querySelector('[data-gallery-track]');
      const slides = gallery.querySelectorAll('.product-page__slide');
      const thumbs = gallery.querySelectorAll('[data-thumb-index]');
      var currentIndex = 0;

      function showSlide(index) {
        index = Math.max(0, Math.min(index, slides.length - 1));
        currentIndex = index;
        if (track && slides.length > 0) {
          var pct = (index * 100) / slides.length;
          track.style.transform = 'translateX(-' + pct + '%)';
        }
        thumbs.forEach(function (t, i) { t.classList.toggle('product-page__thumb--active', i === index); });
        var thumb = thumbs[index];
        if (thumb && thumb.parentElement) {
          thumb.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
        }
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          var index = parseInt(thumb.getAttribute('data-thumb-index'), 10);
          showSlide(index);
        });
      });
    }

    const form = document.querySelector('[data-product-form]');
    if (!form) return;
    const variants = {{ product.variants | json }};
    const optionBtns = form.querySelectorAll('.product-page__option-btn');
    const variantInput = form.querySelector('[data-variant-input]');
    const priceEl = document.querySelector('[data-product-price]');
    const addBtn = form.querySelector('[data-add-to-cart]');
    if (!variants.length || !variantInput) return;

    function findVariant(selectedOptions) {
      return variants.find(function (v) {
        return v.option1 === (selectedOptions[0] || null) &&
               v.option2 === (selectedOptions[1] || null) &&
               v.option3 === (selectedOptions[2] || null);
      });
    }

    function formatMoney(cents) {
      return new Intl.NumberFormat(document.documentElement.lang || 'en', {
        style: 'currency',
        currency: form.dataset.currency || 'USD'
      }).format(cents / 100);
    }

    function updateUI(variant) {
      if (!variant) return;
      variantInput.value = variant.id;
      if (addBtn) {
        addBtn.disabled = !variant.available;
        addBtn.innerHTML = variant.available ? ('{{ "products.add_to_cart" | t }} — ' + formatMoney(variant.price)) : '{{ "products.sold_out" | t }}';
      }
      if (priceEl) {
        var current = priceEl.querySelector('.product-page__price-current');
        var compare = priceEl.querySelector('.product-page__price-compare');
        var badge = priceEl.querySelector('.product-page__badge');
        if (current) current.textContent = formatMoney(variant.price);
        if (compare) {
          compare.textContent = formatMoney(variant.compare_at_price);
          compare.style.display = (variant.compare_at_price > variant.price) ? '' : 'none';
        }
        if (badge) badge.style.display = (variant.compare_at_price > variant.price) ? '' : 'none';
      }
      optionBtns.forEach(function (btn) {
        var match = btn.dataset.optionValue === variant.option1 || btn.dataset.optionValue === variant.option2 || btn.dataset.optionValue === variant.option3;
        btn.classList.toggle('product-page__option-btn--selected', match);
      });
    }

    const optionNames = [];
    form.querySelectorAll('[data-option-name]').forEach(function (g) { optionNames.push(g.dataset.optionName); });

    optionBtns.forEach(function (btn) {
      if (btn.disabled) return;
      btn.addEventListener('click', function () {
        var optGroup = btn.closest('.product-page__options');
        var selected = [null, null, null];
        form.querySelectorAll('.product-page__options').forEach(function (g) {
          var idx = parseInt(g.dataset.optionIndex, 10);
          var sel = g.querySelector('.product-page__option-btn--selected');
          if (sel && g !== optGroup) selected[idx] = sel.dataset.optionValue;
        });
        var clickedIdx = parseInt(optGroup.dataset.optionIndex, 10);
        selected[clickedIdx] = btn.dataset.optionValue;
        optGroup.querySelectorAll('.product-page__option-btn').forEach(function (b) { b.classList.remove('product-page__option-btn--selected'); });
        btn.classList.add('product-page__option-btn--selected');
        var variant = findVariant(selected);
        if (variant) updateUI(variant);
      });
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .product-page {
    padding: 3rem var(--page-margin) 4rem;
  }
  .product-page__main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: var(--page-width);
    margin: 0 auto;
    align-items: start;
  }
  @media (max-width: 768px) {
    .product-page__main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  .product-page__gallery {
    position: sticky;
    top: 2rem;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }
  .product-page__slider-wrap {
    position: relative;
    overflow: hidden;
  }
  .product-page__slider-track {
    display: flex;
    transition: transform 0.35s ease;
  }
  .product-page__slide {
    flex: 0 0 calc(100% / var(--slide-count, 1));
    width: calc(100% / var(--slide-count, 1));
    min-width: 0;
  }
  .product-page__slide img,
  .product-page__media-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .product-page__placeholder {
    width: 100%;
    aspect-ratio: 1;
    background: #f5f5f5;
  }
  .product-page__thumbnails {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0 1rem 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    flex-wrap: nowrap;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .product-page__thumbnails::-webkit-scrollbar {
    height: 6px;
  }
  .product-page__thumbnails::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
  }
  .product-page__thumb {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    background: none;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .product-page__thumb:hover {
    border-color: var(--color-primary);
  }
  .product-page__thumb--active {
    border-color: var(--color-primary);
  }
  .product-page__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-page__info {
    padding: 0 0.5rem;
  }
  .product-page__vendor {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .product-page__title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-foreground);
    line-height: 1.2;
  }
  .product-page__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }
  .product-page__price-current {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .product-page__price-compare {
    font-size: 1.125rem;
    color: #6b7280;
    text-decoration: line-through;
  }
  .product-page__badge {
    display: inline-block;
    background: #dc2626;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
  .product-page__unit-price {
    font-size: 0.875rem;
    color: #6b7280;
    width: 100%;
  }
  .product-page__description {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--color-foreground);
    font-size: 1rem;
  }
  .product-page__description p {
    margin-bottom: 0.75rem;
  }
  .product-page__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .product-page__option {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .product-page__option-label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-foreground);
  }
  .product-page__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .product-page__option-btn {
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border: 2px solid rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .product-page__option-btn:hover:not([disabled]) {
    border-color: var(--color-primary);
  }
  .product-page__option-btn--selected {
    border-color: var(--color-primary);
    background: rgba(13, 148, 136, 0.08);
    color: var(--color-primary);
  }
  .product-page__option-btn--unavailable,
  .product-page__option-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    position: relative;
  }
  .product-page__option-btn--unavailable::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
  }
  .product-page__option-btn--swatch {
    padding: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
  }
  .product-page__swatch {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid rgba(0, 0, 0, 0.1);
  }
  .product-page__swatch--img {
    background-size: cover;
    background-position: center;
  }
  .product-page__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .product-page__quantity label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-foreground);
  }
  .product-page__quantity-input {
    width: 6rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 2px solid rgba(0, 0, 0, 0.2);
    border-radius: 8px;
  }
  .product-page__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .product-page__add-to-cart {
    padding: 1rem 2rem;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.35);
  }
  .product-page__add-to-cart:hover:not(:disabled) {
    background: var(--color-secondary);
    transform: translateY(-2px);
  }
  .product-page__add-to-cart:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
  .product-page__actions .shopify-payment-button {
    margin-top: 0.25rem;
  }
  .product-page__actions .shopify-payment-button__button {
    border-radius: 10px;
    min-height: 52px;
  }
  .product-page__sku {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }
  .product-page__related {
    max-width: var(--page-width);
    margin: 3rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid #eee;
  }
  .product-page__related-title {
    margin-bottom: 2rem;
    font-size: 1.5rem;
  }
  .product-page__related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--related-gap);
  }
  @media (max-width: 768px) {
    .product-page__related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .product-page__related-card {
    text-decoration: none;
    color: inherit;
  }
  .product-page__related-card:hover .product-page__related-card-title {
    text-decoration: underline;
  }
  .product-page__related-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .product-page__related-placeholder {
    aspect-ratio: 1;
    background: #f0f0f0;
  }
  .product-page__related-card-title {
    font-size: 1rem;
    margin-top: 0.5rem;
  }
  .product-page__related-card-price {
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "t:products.show_related",
      "default": false
    },
    {
      "type": "range",
      "id": "related_products_count",
      "label": "t:products.related_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "related_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
