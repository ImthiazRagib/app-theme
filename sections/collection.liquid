{% comment %}
  Renders a collection page with product grid and pagination.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div
  class="collection-page full-width"
  style="--collection-gap: {{ section.settings.grid_gap }}px; --collection-columns: {{ section.settings.columns }}; --card-radius: {{ section.settings.card_radius }}px"
>
  <div class="collection-page__inner">
    <header class="collection-page__header">
      <h1 class="collection-page__title">{{ collection.title | escape }}</h1>
      {%- assign collection_subtitle = settings.collection_page_subtitle | default: collection.description -%}
      {%- if collection_subtitle != blank -%}
        <div class="collection-page__subtitle">{{ collection_subtitle }}</div>
      {%- elsif collection.description != blank -%}
        <div class="collection-page__description">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-page__grid">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" class="collection-page__card">
              {%- if product.featured_image -%}
                <div class="collection-page__card-image">
                  {{
                    product.featured_image
                    | image_url: width: 600, height: 600, crop: 'center'
                    | image_tag: loading: 'lazy', alt: product.title
                  }}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="collection-page__badge">{{ 'products.on_sale' | t }}</span>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="collection-page__card-placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'collection-page__placeholder' }}
                </div>
              {%- endif -%}
              <div class="collection-page__card-content">
                <h3 class="collection-page__card-title">{{ product.title }}</h3>
                <p class="collection-page__card-price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="collection-page__card-price--sale">{{ product.price | money }}</span>
                    <span class="collection-page__card-price--compare">{{ product.compare_at_price | money }}</span>
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </p>
              </div>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="collection-page__pagination" aria-label="{{ 'general.pagination' | t }}">
            {{ paginate | default_pagination: previous: '‹', next: '›' }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="collection-page__empty">
          <p class="collection-page__empty-text">{{ 'collections.empty' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .collection-page {
    padding: clamp(2rem, 4vw, 3rem) var(--page-margin) 4rem;
    background: var(--color-background);
  }
  .collection-page__inner {
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .collection-page__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2.5rem;
    width: 100%;
  }
  .collection-page__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }
  .collection-page__subtitle,
  .collection-page__description {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-foreground);
    opacity: 0.85;
    max-width: 42rem;
    margin: 0 auto;
  }
  .collection-page__subtitle p,
  .collection-page__description p {
    margin: 0 0 0.5rem;
  }
  .collection-page__subtitle p:last-child,
  .collection-page__description p:last-child {
    margin-bottom: 0;
  }
  .collection-page__grid {
    display: grid;
    grid-template-columns: repeat(var(--collection-columns), 1fr);
    gap: var(--collection-gap);
  }
  @media (max-width: 768px) {
    .collection-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .collection-page__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: var(--card-radius);
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .collection-page__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  }
  .collection-page__card:hover .collection-page__card-title {
    color: var(--color-primary);
  }
  .collection-page__card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .collection-page__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .collection-page__card:hover .collection-page__card-image img {
    transform: scale(1.05);
  }
  .collection-page__card-placeholder {
    aspect-ratio: 1;
    background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .collection-page__placeholder {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }
  .collection-page__badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--color-secondary);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }
  .collection-page__card-content {
    padding: 1.25rem 1rem;
  }
  .collection-page__card-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: var(--color-primary);
    transition: color 0.2s;
    line-height: 1.3;
  }
  .collection-page__card-price {
    font-weight: 500;
    color: var(--color-secondary);
  }
  .collection-page__card-price--compare {
    text-decoration: line-through;
    opacity: 0.65;
    margin-left: 0.5rem;
    font-weight: 400;
  }
  .collection-page__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 3rem;
  }
  .collection-page__pagination .page,
  .collection-page__pagination .next,
  .collection-page__pagination .previous {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-secondary);
    opacity: 0.9;
    transition: opacity 0.2s, color 0.2s;
  }
  .collection-page__pagination .page:hover,
  .collection-page__pagination .next:hover,
  .collection-page__pagination .previous:hover {
    opacity: 1;
    color: var(--color-secondary-dark);
  }
  .collection-page__pagination .page.current {
    opacity: 1;
    color: var(--color-secondary);
    font-weight: 600;
  }
  .collection-page__empty {
    text-align: center;
    padding: 4rem 2rem;
  }
  .collection-page__empty-text {
    font-size: 1.125rem;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:landing.products_to_show",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:landing.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:landing.card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
