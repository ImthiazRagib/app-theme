{% comment %}
  Renders a newsletter signup section using Shopify's built-in customer form.
  Includes a wave divider above for visual separation.
{% endcomment %}

<div class="newsletter full-width" style="--newsletter-bg: {{ section.settings.background_color }}; --newsletter-accent: {{ section.settings.accent_color }}; --newsletter-fg: {{ section.settings.text_color }};">
  <div class="newsletter__wave" aria-hidden="true">
    <svg class="newsletter__wave-svg" viewBox="0 0 1440 100" preserveAspectRatio="none">
      <path class="newsletter__wave-path" d="M0 50 C 240 0 480 100 720 50 C 960 0 1200 100 1440 50 L 1440 100 L 0 100 Z"/>
    </svg>
  </div>
  <div class="newsletter__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="newsletter__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="newsletter__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__field">
        <input
          type="email"
          name="contact[email]"
          class="newsletter__input"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder | escape }}"
          aria-label="{{ section.settings.placeholder | escape }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
        >
        <button type="submit" class="newsletter__button" name="commit">
          {{ section.settings.button_label | escape }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__message newsletter__message--success">{{ 'landing.newsletter_success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="newsletter__message newsletter__message--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .newsletter {
    background: linear-gradient(135deg, var(--newsletter-bg) 0%, var(--newsletter-accent) 100%);
    color: var(--newsletter-fg);
    padding: 5rem var(--page-margin);
    position: relative;
    overflow: visible;
  }
  .newsletter__wave {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    line-height: 0;
    transform: translateY(-100%);
  }
  .newsletter__wave-svg {
    width: 100%;
    height: 72px;
  }
  .newsletter__wave-path {
    fill: var(--newsletter-bg);
  }
  .newsletter::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  .newsletter__inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .newsletter__title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .newsletter__subtitle {
    margin-bottom: 2rem;
    opacity: 0.95;
  }
  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .newsletter__field {
    display: flex;
    gap: 0;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
  }
  .newsletter__input {
    flex: 1;
    padding: 1.125rem 1.5rem;
    border: none;
    background: transparent;
    color: inherit;
    font-size: 1rem;
  }
  .newsletter__input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }
  .newsletter__input:focus {
    outline: none;
    background: rgba(255, 255, 255, 0.05);
  }
  .newsletter__button {
    padding: 1.125rem 1.75rem;
    background: #fff;
    color: var(--color-secondary);
    border: none;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .newsletter__button:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }
  .newsletter__message {
    font-size: 0.875rem;
  }
  .newsletter__message--success {
    color: #86efac;
  }
  .newsletter__message--error {
    color: #fca5a5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:landing.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:landing.subtitle",
      "default": "Get updates on new products and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:landing.placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:landing.button_label",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#0f766e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:landing.accent_color",
      "default": "#134e4a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:landing.text_color",
      "default": "#ffffff"
    }
  ],
  "presets": [{ "name": "t:landing.newsletter" }]
}
{% endschema %}
