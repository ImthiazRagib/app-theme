[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "default": "#0d9488",
        "label": "t:labels.color_primary"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "default": "#0f766e",
        "label": "t:labels.color_secondary"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:landing.product_details",
    "settings": [
      {
        "type": "header",
        "content": "t:landing.product_banner"
      },
      {
        "type": "text",
        "id": "product_banner_title",
        "label": "t:labels.title",
        "default": "Premium quality"
      },
      {
        "type": "text",
        "id": "product_banner_subtitle",
        "label": "t:landing.subtitle",
        "default": "Free shipping on all orders."
      },
      {
        "type": "text",
        "id": "product_banner_button_label",
        "label": "t:landing.button_label",
        "default": "Shop collection"
      },
      {
        "type": "url",
        "id": "product_banner_button_link",
        "label": "t:labels.link"
      },
      {
        "type": "header",
        "content": "t:landing.wavy_banner"
      },
      {
        "type": "text",
        "id": "product_wavy_title",
        "label": "t:labels.title",
        "default": "Transform your bathing experience into bliss"
      },
      {
        "type": "richtext",
        "id": "product_wavy_body",
        "label": "t:labels.content",
        "default": "<p>Feel the daily embrace of warmth and softness underfoot, turning each step into a moment of pure relaxation. Enjoy a worry-free space with slip resistance, ensuring your home is both stylish and safe for everyone.</p>"
      },
      {
        "type": "header",
        "content": "t:landing.feature_cards"
      },
      {
        "type": "text",
        "id": "product_feature_title",
        "label": "t:labels.title",
        "default": "Unleash your charisma and captivate the room"
      },
      {
        "type": "text",
        "id": "product_feature_card_1",
        "label": "t:landing.feature_card",
        "default": "Long-lasting fragrance"
      },
      {
        "type": "text",
        "id": "product_feature_card_2",
        "label": "t:landing.feature_card",
        "default": "Versatile for any occasion"
      },
      {
        "type": "text",
        "id": "product_feature_card_3",
        "label": "t:landing.feature_card",
        "default": "Elegant travel-friendly design"
      },
      {
        "type": "text",
        "id": "product_feature_card_4",
        "label": "t:landing.feature_card",
        "default": "Modern, sophisticated appeal"
      }
    ]
  },
  {
    "name": "t:landing.video_settings",
    "settings": [
      {
        "type": "text",
        "id": "video_url",
        "label": "t:landing.video_url",
        "info": "t:landing.video_url_info"
      },
      {
        "type": "textarea",
        "id": "video_url_info",
        "label": "t:labels.video_url_info",
        "default": "Paste a YouTube or Vimeo URL to play the video. Autoplays muted."
      }
    ]
  }
]
